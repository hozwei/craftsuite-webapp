# Settings for compose.yaml. Copy this file to .env (cp .env.example .env && chmod 600 .env) and
# fill it in; docs/configuration.md explains every setting. Keep .env private: it holds two
# secrets. Put a value in single quotes if it contains $, # or a backslash; spaces between words
# need no quotes.

# --- Where the apps are served ------------------------------------------------------------------
# Public host name of the apps, without https:// (your reverse proxy terminates TLS for it).
CRAFT_HOST=craft.example.com
# Port on this machine that your reverse proxy forwards to. "127.0.0.1:8080" keeps it local.
CRAFT_PORT=8080
# Folder for the app releases, the updater's state and the layer bundle. It and everything in it
# must belong to CRAFT_USER, which the updater runs as.
CRAFT_DATA_DIR=./data
CRAFT_USER=1000:1000
# Time zone for the update time, the logs and the start page, e.g. Europe/Berlin.
TZ=UTC

# --- Sign-in (oauth2-proxy with your OpenID Connect provider) -----------------------------------
# Issuer exactly as the provider's /.well-known/openid-configuration states it, with plain
# slashes (JSON may show them as \/), without a slash at the end.
CRAFT_OIDC_ISSUER_URL=https://cloud.example.com
CRAFT_OIDC_CLIENT_ID=craft-example-com-oauth2-proxy-gate
CRAFT_OIDC_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32 | tr -- '+/' '-_'
CRAFT_COOKIE_SECRET=
# How long a sign-in lasts (oauth2-proxy duration, e.g. 12h or 168h).
CRAFT_SESSION_LIFETIME=12h

# --- Updates ------------------------------------------------------------------------------------
# Daily check, local time (HH:MM). A release is taken once it is at least CRAFT_MIN_AGE_HOURS old
# and, with the canary check on, the first canary run of your layer version after it has passed it.
CRAFT_UPDATE_TIME=07:00
CRAFT_MIN_AGE_HOURS=24
# auto: the apps nextcloud-craftsuite-layer lists (its apps.json, layer 0.5.0 and later), new ones
# included. "auto -lightcraft" leaves one out; app ids such as "pdfcraft photocraft" name them.
CRAFT_APPS=auto

# --- Start page ---------------------------------------------------------------------------------
# en or de
CRAFT_LANGUAGE=en
# Optional button at the top right, e.g. https://cloud.example.com/apps/files/. Empty: no button.
CRAFT_LINK_URL=
CRAFT_LINK_LABEL=Nextcloud

# --- Nextcloud integration (nextcloud-craftsuite-layer), see docs/nextcloud.md -----------------
# Origins of the Nextcloud servers that may frame the apps, separated by spaces: https://host or
# https://host:port, no path, no slash at the end. Empty: no site may frame the apps.
CRAFTSUITE_ALLOWED_ORIGINS=
# The layer release whose translator the updater adds, and the SHA-256 of its hosting bundle.
# Empty version: the apps are served without the Nextcloud integration. For release 0.5.1:
#   CRAFTSUITE_LAYER_VERSION=0.5.1
#   CRAFTSUITE_LAYER_SHA256=78b8ef13419204c1148a10b0eddea9df32c5170103dbe3460b3e67993547aa32
CRAFTSUITE_LAYER_VERSION=
CRAFTSUITE_LAYER_SHA256=
# off: do not let the layer's canary hold back new app releases.
CRAFTSUITE_CANARY=on
# How long the translator waits for an app to start, as app=milliseconds separated by spaces.
# Empty: the layer's app list recommends them (180000 for LightCraft and EffectCraft), other apps
# get the translator's 60 seconds. For slow connections add filmcraft=180000.
CRAFTSUITE_STARTUP_TIMEOUTS=
